# ==========================================================================
#  QQ 机器人配置模板
#  用法：复制为 .env（cp .env.example .env），然后逐项填写。
#  所有密钥请留空或填自己的，切勿把真实密钥提交到 Git。
# ==========================================================================

# ---------------------------- 服务监听 ----------------------------
# 通信地址，一般默认即可
HOST=0.0.0.0
# 通信端口，需与 NapCat 的 onebot11 配置里的 url 端口一致
PORT=8081
# OneBot 通信 token，必须与 napcat/config/onebot11_<QQ号>.json 中的 token 完全相同
# 留空会导致连接被拒绝，请务必填写
ONEBOT_ACCESS_TOKEN=

# ---------------------------- 天气（和风天气）----------------------------
# https://console.qweather.com/ 申请；留空则天气功能自动禁用
QWEATHER_APIKEY=
# 开发者专属 API Host（形如 xxxxxx.re.qweatherapi.com，不要带 https:// 前缀）
QWEATHER_HOST=

# ---------------------------- AI 对话（DeepSeek）----------------------------
# https://platform.deepseek.com/ 申请；留空则 AI 聊天与识图自动禁用
DEEPSEEK_APIKEY=
# 使用的模型，deepseek-flash 支持图片识别
DEEPSEEK_MODEL=deepseek-flash
# 接口地址，一般无需修改
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ---------------------------- 功能触发范围 ----------------------------
# 菠萝复读功能所在群号，留空则该功能不触发
PINEAPPLE_GROUP_ID=
# AI 聊天白名单群号，多个群用英文逗号分隔；留空则群聊不触发（私聊不受影响）
AI_CHAT_GROUPS=
# 群聊中触发 AI 聊天的前缀
AI_CHAT_PREFIX=..
# 私聊中以该符号开头可取消回复字数限制
PRIVATE_UNLIMITED_PREFIX=$
# 单条消息最大字符数，超过会自动切分
SINGLE_MESSAGE_MAX_LEN=500

# ---------------------------- 视频解析插件（可选）----------------------------
# 提高超时时间，防止服务器上传带宽低导致下载超时
API_TIMEOUT=30.0
# B站视频最大解析时长（秒），超过则拒绝解析
r_video_duration_maximum=480
# 最大下载文件体积（MB）
r_max_size=100
# 是否使用合并转发消息
r_need_forward=True
# 是否使用base64编码发送媒体
r_use_base64=False
